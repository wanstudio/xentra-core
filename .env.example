# ============================================
# Xentra Core — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=3000

# Database
DB_PATH=/home/USERNAME/xentra-core/server/database/xentra.db

# Initial admin password (used only on first seed)
INITIAL_ADMIN_PASSWORD=bangjo123

# Mapbox token for routing/geocoding (optional, leave empty to disable)
MAPBOX_TOKEN=

# ============================================
# Enterprise Connector
# ============================================
# Optional per-tenant connector endpoint/credential values.
# Do not expose these to browser/client JavaScript or commit real values.
XENTRA_CONNECTOR_URL=
XENTRA_CONNECTOR_ID=
XENTRA_CONNECTOR_HMAC_SECRET=
XENTRA_CONNECTOR_TIMEOUT_MS=10000
XENTRA_CONTRACT_VERSION=v1

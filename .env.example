# ============================================
# Xentra Core — Environment Variables
# ============================================
# Copy this file to .env and fill in the values

# Server
NODE_ENV=production
PORT=3000

# Database
DB_PATH=/home/USERNAME/xentra-core/server/database/xentra.db

# Initial admin password (used only on first seed)
INITIAL_ADMIN_PASSWORD=bangjo123

# Mapbox token for routing/geocoding (optional, leave empty to disable)
MAPBOX_TOKEN=

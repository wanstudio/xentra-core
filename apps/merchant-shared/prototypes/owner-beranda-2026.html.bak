            <path d="M5.62891 1.68866L7.42374 0.365907C7.89216 0.0197867 8.45923 -0.166992 9.04166 -0.166992C9.62408 -0.166992 10.1912 0.0197867 10.6596 0.365907L12.4645 1.69599C11.7092 1.66666 10.8658 1.66666 9.94274 1.66666H7.95357C7.10841 1.66666 6.33199 1.66666 5.62891 1.68866Z"/>
          </svg>
        </div>
        <span class="nav-tab-label">Finance</span>
      </button>

      <!-- 5. Lainnya -->
      <button type="button" class="nav-tab-btn" onclick="switchNavTab(this, 'Lainnya')">
        <div class="nav-tab-indicator"></div>
        <div class="nav-tab-icon">
          <!-- bxs_category.svg -->
          <svg viewBox="0 0 25 25">
            <path d="M4.16667 11.4583H10.4167C10.6929 11.4583 10.9579 11.3486 11.1532 11.1532C11.3486 10.9579 11.4583 10.6929 11.4583 10.4167V4.16667C11.4583 3.8904 11.3486 3.62545 11.1532 3.4301C10.9579 3.23475 10.6929 3.125 10.4167 3.125H4.16667C3.8904 3.125 3.62545 3.23475 3.4301 3.4301C3.23475 3.62545 3.125 3.8904 3.125 4.16667V10.4167C3.125 10.6929 3.23475 10.9579 3.4301 11.1532C3.62545 11.3486 3.8904 11.4583 4.16667 11.4583ZM14.5833 11.4583H20.8333C21.1096 11.4583 21.3746 11.3486 21.5699 11.1532C21.7653 10.9579 21.875 10.6929 21.875 10.4167V4.16667C21.875 3.8904 21.7653 3.62545 21.5699 3.4301C21.3746 3.23475 21.1096 3.125 20.8333 3.125H14.5833C14.3071 3.125 14.0421 3.23475 13.8468 3.4301C13.6514 3.62545 13.5417 3.8904 13.5417 4.16667V10.4167C13.5417 10.6929 13.6514 10.9579 13.8468 11.1532C14.0421 11.3486 14.3071 11.4583 14.5833 11.4583ZM4.16667 21.875H10.4167C10.6929 21.875 10.9579 21.7653 11.1532 21.5699C11.3486 21.3746 11.4583 21.1096 11.4583 20.8333V14.5833C11.4583 14.3071 11.3486 14.0421 11.1532 13.8468C10.9579 13.6514 10.6929 13.5417 10.4167 13.5417H4.16667C3.8904 13.5417 3.62545 13.6514 3.4301 13.8468C3.23475 14.0421 3.125 14.3071 3.125 14.5833V20.8333C3.125 21.1096 3.23475 21.3746 3.4301 21.5699C3.62545 21.7653 3.8904 21.875 4.16667 21.875ZM17.7083 21.875C20.0063 21.875 21.875 20.0063 21.875 17.7083C21.875 15.4104 20.0063 13.5417 17.7083 13.5417C15.4104 13.5417 13.5417 15.4104 13.5417 17.7083C13.5417 20.0063 15.4104 21.875 17.7083 21.875Z"/>
          </svg>
        </div>
        <span class="nav-tab-label">Lainnya</span>
      </button>
    </nav>

    <!-- ==========================================================================
         BRANCH SELECTION BOTTOM SHEET MODAL
         ========================================================================== -->
    <div class="sheet-overlay" id="sheet-overlay" onclick="closeAllSheets()"></div>
    <div class="bottom-sheet" id="branch-sheet">
      <div class="sheet-handle"></div>
      <h3 class="sheet-title">Pilih Cabang Operasional</h3>
      <div class="branch-list-group">
        <div class="branch-select-row selected" id="row-branch-all" onclick="selectBranch('Semua Cabang (Konsolidasi)', 'Konsolidasi 3 Outlet Aktif')">
          <div>
            <div class="branch-select-name">Semua Cabang (Konsolidasi)</div>
            <div class="branch-select-sub">Gabungan omset Pringsewu, Gadingrejo & Kemiling</div>
          </div>
          <span style="font-size: 16px; color: var(--brand-green);">✓</span>
        </div>

        <div class="branch-select-row" id="row-branch-pringsewu" onclick="selectBranch('MyBangjo Pringsewu', 'Outlet Utama • Jl. Sudirman No. 45')">
          <div>
            <div class="branch-select-name">MyBangjo Pringsewu</div>
            <div class="branch-select-sub">Outlet Utama • Jl. Sudirman No. 45</div>
          </div>
        </div>

        <div class="branch-select-row" id="row-branch-gadingrejo" onclick="selectBranch('MyBangjo Gadingrejo', 'Cabang 02 • Rest Area Gading')">
          <div>
            <div class="branch-select-name">MyBangjo Gadingrejo</div>
            <div class="branch-select-sub">Cabang 02 • Rest Area Gading</div>
          </div>
        </div>

        <div class="branch-select-row" id="row-branch-kemiling" onclick="selectBranch('MyBangjo Kemiling', 'Cabang 03 • Jl. Imam Bonjol')">
          <div>
            <div class="branch-select-name">MyBangjo Kemiling</div>
            <div class="branch-select-sub">Cabang 03 • Jl. Imam Bonjol</div>
          </div>
        </div>
      </div>
    </div>

    <!-- ==========================================================================
         AUDIT & GOVERNANCE BOTTOM SHEET (2-TIER PROBLEM BAROMETER)
         ========================================================================== -->
    <div class="bottom-sheet" id="anomaly-sheet">
      <div class="sheet-handle"></div>
      
      <!-- Sheet Header -->
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
        <h3 class="sheet-title" style="margin: 0; font-size: 16px;">Tata Kelola & Audit Cabang</h3>
        <span style="font-size: 10.5px; font-weight: 800; background: var(--bg-subtle); color: var(--text-muted); padding: 3px 8px; border-radius: var(--radius-full); border: 1px solid var(--border-light);">Barometer Wewenang</span>
      </div>
      <p style="font-size: 11px; color: var(--text-muted); margin: 0 0 12px 0; line-height: 1.35;">
        Membedakan kejadian operasional yang tuntas di level cabang vs kasus berat yang melampaui limit wewenang manager.
      </p>

      <!-- Segmented Tab Pills -->
      <div class="audit-tab-pills">
        <button type="button" class="audit-tab-btn active" id="tab-btn-pending" onclick="switchAuditTab('pending')">
          <span>⚠️ Butuh Putusan Owner</span>
          <span class="audit-tab-badge badge-danger" id="badge-tab-pending">2</span>
        </button>
        <button type="button" class="audit-tab-btn" id="tab-btn-fyi" onclick="switchAuditTab('fyi')">
          <span>📋 Selesai di Cabang (FYI)</span>
          <span class="audit-tab-badge badge-neutral">3</span>
        </button>
      </div>

      <!-- TAB 1: KASUS BERAT / MELAMPAUI THRESHOLD (BUTUH PUTUSAN OWNER) -->
      <div id="audit-content-pending">
        <div style="font-size: 11px; background: rgba(225, 29, 72, 0.08); color: var(--status-rose); padding: 8px 10px; border-radius: var(--radius-sm); border: 1px solid rgba(225, 29, 72, 0.2); margin-bottom: 12px; line-height: 1.35;">
          <strong>Wajib Keputusan Owner:</strong> Kasus ini melampaui batas toleransi SPV Cabang (Limit: Rp 50.000) atau terindikasi anomali sistemik. Pembukuan kas ditahan sampai Anda memberi putusan resmi.
        </div>

        <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 16px; max-height: 44vh; overflow-y: auto; padding-right: 2px;">
          <!-- Case 1: Selisih Kas Laci Melebihi Batas -->
          <div class="anomaly-card" id="anomaly-card-1">
            <div class="anomaly-card-top">
              <span class="anomaly-badge-type" style="color: var(--status-rose);">⚠️ Selisih Kas Laci Tutup Shift</span>
              <span class="anomaly-nominal" style="color: var(--status-rose); font-size: 13.5px;">- Rp 175.000</span>
            </div>
            <div class="anomaly-info-box">
              <div><strong>MyBangjo Kemiling</strong> • Shift Siang (Kasir: Siti Rahma)</div>
              <div style="margin-top: 3px;">Sistem Catat: <strong>Rp 825.000</strong> | Fisik Laci: <strong>Rp 650.000</strong></div>
              <div style="margin-top: 3px; color: var(--status-amber-text);">Catatan SPV Doni: <em>"Uang fisik tercecer saat jam makan siang padat. SPV mengajukan toleransi resto."</em></div>
            </div>
            <div style="font-size: 10.5px; font-weight: 700; color: #b45309; background: rgba(245, 158, 11, 0.12); padding: 5px 8px; border-radius: var(--radius-xs); border: 1px solid rgba(245, 158, 11, 0.25);">
              Batas Otonom SPV: Rp 50.000 • <strong>Pelanggaran Limit: +Rp 125.000</strong>
            </div>
            <div class="anomaly-actions-row">
              <button type="button" class="btn-action-approve" onclick="resolveSingleAnomaly('anomaly-card-1', 'approved', 'Selisih kas laci Rp 175rb disahkan beban operasional resto')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Setujui (Beban Resto)</span>
              </button>
              <button type="button" class="btn-action-veto" onclick="resolveSingleAnomaly('anomaly-card-1', 'vetoed', 'Selisih kas laci Rp 175rb di-veto: Bebankan potong insentif kasir')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                <span>Veto: Potong Kasir</span>
              </button>
            </div>
            <div class="anomaly-settled-pill" id="anomaly-card-1-settled"></div>
          </div>

          <!-- Case 2: Indikasi Kolusi / Pola Void Berulang -->
          <div class="anomaly-card" id="anomaly-card-2">
            <div class="anomaly-card-top">
              <span class="anomaly-badge-type" style="color: #7c3aed;">🚨 Pola Anomali Void (AI Flag)</span>
              <span class="anomaly-nominal" style="font-size: 13.5px;">Rp 340.000</span>
            </div>
            <div class="anomaly-info-box">
              <div><strong>MyBangjo Pringsewu</strong> • Kasir: Budi Santoso</div>
              <div style="margin-top: 3px;">Analisis Sistem: <strong>12x pembatalan tunai dalam 2 hari berturut-turut</strong>, seluruhnya disetujui SPV Rian.</div>
              <div style="margin-top: 3px; color: var(--status-rose);">Status: <em>PIN Wewenang Void SPV Rian dibekukan sementara oleh sistem.</em></div>
            </div>
            <div style="font-size: 10.5px; font-weight: 700; color: #6d28d9; background: rgba(124, 58, 237, 0.1); padding: 5px 8px; border-radius: var(--radius-xs); border: 1px solid rgba(124, 58, 237, 0.25);">
              Indikasi: Potensi Kolusi Kasir-SPV • Perlu Otoritas Eksekutif
            </div>
            <div class="anomaly-actions-row">
              <button type="button" class="btn-action-approve" onclick="resolveSingleAnomaly('anomaly-card-2', 'approved', 'Wewenang PIN SPV Rian dibuka kembali (Alasan sah)')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Buka Kunci (Alasan Sah)</span>
              </button>
              <button type="button" class="btn-action-veto" onclick="resolveSingleAnomaly('anomaly-card-2', 'vetoed', 'Perintah Audit CCTV Pringsewu diterbitkan ke tim pengawas')">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>Tugaskan Audit CCTV</span>
              </button>
            </div>
            <div class="anomaly-settled-pill" id="anomaly-card-2-settled"></div>
          </div>
        </div>

        <div style="display: flex; gap: 10px;">
          <button type="button" id="btn-batch-approve" style="flex: 1; padding: 12px 10px; background: var(--brand-green); color: #fff; border: none; border-radius: var(--radius-md); font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;" onclick="approveAllBranchDecisions()">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
            <span>Otorisasi Semua Kasus Berat</span>
          </button>
          <button type="button" style="padding: 12px 16px; background: var(--bg-subtle); color: var(--text-main); border: 1px solid var(--border-light); border-radius: var(--radius-md); font-family: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer;" onclick="closeAllSheets()">
            Tutup
          </button>
        </div>
      </div>

      <!-- TAB 2: KASUS RINGAN / SELESAI DI CABANG (READ-ONLY FYI STREAM) -->
      <div id="audit-content-fyi" style="display: none;">
        <div style="font-size: 11px; background: rgba(8, 169, 79, 0.08); color: var(--brand-green-dark); padding: 8px 10px; border-radius: var(--radius-sm); border: 1px solid rgba(8, 169, 79, 0.2); margin-bottom: 12px; line-height: 1.35;">
          <strong>Cukup Diketahui (Read-Only):</strong> Masalah operasional harian di bawah batas limit wewenang SPV (Rp 50.000). Telah diselesaikan secara otonom di cabang tanpa menghentikan operasional toko.
        </div>

        <div style="display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; max-height: 44vh; overflow-y: auto; padding-right: 2px;">
          <!-- FYI 1: Void Varian Sambal Ringan -->
          <div class="fyi-card">
            <div class="fyi-card-header">
              <span class="fyi-title">Pembatalan Pesanan #MB-8891</span>
              <span class="fyi-nominal">Rp 24.000</span>
            </div>
            <div class="fyi-meta">
              <strong>MyBangjo Pringsewu</strong> • Kasir: Budi Santoso (13:42 WIB)<br>
              Alasan: <em>"Salah klik varian sambal sebelum diproses dapur."</em>
            </div>
            <div class="fyi-badge-row">
              <span class="fyi-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Tuntas di Cabang (SPV Rian: Waste Dapur)</span>
              </span>
              <span class="fyi-authority-note">Limit: &lt; Rp 50rb</span>
            </div>
          </div>

          <!-- FYI 2: Selisih Receh Kembalian -->
          <div class="fyi-card">
            <div class="fyi-card-header">
              <span class="fyi-title">Selisih Pembulatan Receh Kembalian</span>
              <span class="fyi-nominal" style="color: var(--status-rose);">- Rp 4.000</span>
            </div>
            <div class="fyi-meta">
              <strong>MyBangjo Gadingrejo</strong> • Kasir: Deni (Tutup Shift Pagi)<br>
              Keterangan: <em>"Kekurangan koin kembalian Rp 500 saat jam makan pagi."</em>
            </div>
            <div class="fyi-badge-row">
              <span class="fyi-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Tuntas di Cabang (SPV Arif: Toleransi Kasir)</span>
              </span>
              <span class="fyi-authority-note">Limit: &lt; Rp 20rb</span>
            </div>
          </div>

          <!-- FYI 3: Petty Cash Darurat -->
          <div class="fyi-card">
            <div class="fyi-card-header">
              <span class="fyi-title">Kas Kecil Darurat (Beli Es Batu)</span>
              <span class="fyi-nominal">Rp 65.000</span>
            </div>
            <div class="fyi-meta">
              <strong>MyBangjo Pringsewu</strong> • Pukul 11:15 WIB<br>
              Keterangan: <em>"Beli es batu kristal 2 bal karena stok pemasok terlambat. Struk fisik diarsipkan."</em>
            </div>
            <div class="fyi-badge-row">
              <span class="fyi-tag">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                <span>Tuntas di Cabang (SPV Rian: Petty Cash Sah)</span>
              </span>
              <span class="fyi-authority-note">Limit: &lt; Rp 100rb</span>
            </div>
          </div>
        </div>

        <div style="display: flex; gap: 10px;">
          <button type="button" style="flex: 1; padding: 12px 10px; background: var(--bg-subtle); color: var(--text-main); border: 1px solid var(--border-light); border-radius: var(--radius-md); font-family: inherit; font-size: 12px; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;" onclick="showToast('Export Log', 'Rekap log wewenang cabang 30 hari berhasil diunduh (PDF)')">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span>Unduh Rekap Log Cabang</span>
          </button>
          <button type="button" style="padding: 12px 16px; background: var(--brand-green); color: #fff; border: none; border-radius: var(--radius-md); font-family: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer;" onclick="closeAllSheets()">
            Tutup
          </button>
        </div>
      </div>

    </div>
    <!-- ==========================================================================
         TARGET & BUDGETING BOTTOM SHEET (SMART CALIBRATION ENGINE)
         ========================================================================== -->
    <div class="bottom-sheet" id="target-sheet">
      <div class="sheet-handle"></div>
      
      <!-- Sheet Header -->
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px;">
        <h3 class="sheet-title" style="margin: 0; font-size: 16px;">⚙️ Pengaturan Target & Anggaran</h3>
        <span style="font-size: 10.5px; font-weight: 800; background: var(--bg-subtle); color: var(--brand-green-dark); padding: 3px 8px; border-radius: var(--radius-full); border: 1px solid var(--border-light);">Smart Engine</span>
      </div>
      <p style="font-size: 11px; color: var(--text-muted); margin: 0 0 12px 0; line-height: 1.35;">
        Kalkulasi cerdas otomatis memecah target bulanan ke ritme harian berdasarkan BEP dan bobot historis toko.
      </p>

      <!-- Outlet Scope Pills -->
      <div class="target-scope-pills">
        <button type="button" class="target-scope-btn active" id="scope-btn-all" onclick="setTargetScope('all')">Konsolidasi (Semua)</button>
        <button type="button" class="target-scope-btn" id="scope-btn-pringsewu" onclick="setTargetScope('pringsewu')">MyBangjo Pringsewu</button>
        <button type="button" class="target-scope-btn" id="scope-btn-gadingrejo" onclick="setTargetScope('gadingrejo')">MyBangjo Gadingrejo</button>
        <button type="button" class="target-scope-btn" id="scope-btn-kemiling" onclick="setTargetScope('kemiling')">MyBangjo Kemiling</button>
      </div>

      <!-- Mode Selector: Smart Growth vs Lump Sum -->
      <div class="audit-tab-pills" style="margin-bottom: 12px;">
        <button type="button" class="audit-tab-btn active" id="tab-mode-smart" onclick="switchTargetMode('smart')">
          <span>⚡ Smart Growth (+% MoM)</span>
        </button>
        <button type="button" class="audit-tab-btn" id="tab-mode-nominal" onclick="switchTargetMode('nominal')">
          <span>🎯 Input Lump Sum Bulanan</span>
        </button>
      </div>

      <!-- Scrollable Config Body -->
      <div style="max-height: 48vh; overflow-y: auto; padding-right: 2px; margin-bottom: 16px;">
        <!-- Baseline Variables Card (Automatic from Database) -->
        <div class="target-param-box">
          <div style="font-size: 11.5px; font-weight: 800; color: var(--text-main); display: flex; align-items: center; justify-content: space-between;">
            <span>Data Variabel Database Toko</span>
            <span style="color: var(--brand-green-dark); font-size: 10px; font-weight: 800; background: var(--brand-green-light); padding: 2px 7px; border-radius: var(--radius-full);">✓ Terverifikasi POS</span>
          </div>
          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px; font-size: 11px;">
            <div style="background: var(--bg-subtle); padding: 7px 9px; border-radius: var(--radius-xs); border: 1px solid var(--border-light);">
              <span style="color: var(--text-muted); display: block; font-size: 10px;">Realisasi Bln Lalu</span>
              <strong id="scope-base-past" style="color: var(--text-main); font-size: 12px;">Rp 114.200.000</strong>
            </div>
            <div style="background: var(--bg-subtle); padding: 7px 9px; border-radius: var(--radius-xs); border: 1px solid var(--border-light);">
              <span style="color: var(--text-muted); display: block; font-size: 10px;">BEP Biaya Tetap Toko</span>
              <strong id="scope-base-bep" style="color: var(--text-main); font-size: 12px;">Rp 78.000.000</strong>
            </div>
          </div>
        </div>

        <!-- Mode 1: Smart Growth Slider Control -->
        <div id="container-mode-smart">
          <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 12px;">
            <div style="display: flex; align-items: center; justify-content: space-between;">
              <span style="font-size: 12px; font-weight: 800; color: var(--text-main);">Target Pertumbuhan Bulan Ini</span>
              <span id="growth-badge-text" style="font-size: 15px; font-weight: 900; color: var(--brand-green-dark); background: var(--brand-green-light); padding: 2px 10px; border-radius: var(--radius-full);">+8%</span>
            </div>
            <input type="range" class="target-range-slider" id="input-growth-slider" min="0" max="30" value="8" step="1" oninput="onGrowthSliderChange(this.value)">
            <div style="display: flex; justify-content: space-between; font-size: 10px; color: var(--text-muted); font-weight: 600;">
              <span>0% (Flat)</span>
              <span>+10% (Rekomendasi)</span>
              <span>+20% (Agresif)</span>
              <span>+30% (Maksimal)</span>
            </div>
          </div>
        </div>

        <!-- Mode 2: Lump Sum Input (Toggled) -->
        <div id="container-mode-nominal" style="display: none; margin-bottom: 12px;">
          <div style="background: var(--bg-surface); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 12px 14px;">
            <label style="display: block; font-size: 11.5px; font-weight: 800; color: var(--text-main); margin-bottom: 6px;">
              Input Nominal Target 1 Bulan Penuh (Rp)
            </label>
            <input type="number" id="input-nominal-val" value="123300000" style="width: 100%; box-sizing: border-box; padding: 10px 12px; border-radius: var(--radius-sm); border: 1.5px solid var(--border-light); background: var(--bg-subtle); color: var(--text-main); font-family: inherit; font-size: 14px; font-weight: 800;" oninput="onNominalInputChange(this.value)">
            <span style="font-size: 10.5px; color: var(--text-muted); display: block; margin-top: 4px;">Sistem akan otomatis memecah nominal ini ke 30 hari kalender.</span>
          </div>
        </div>

        <!-- Dynamic Calculation Results Box -->
        <div class="target-output-card">
          <div style="display: flex; align-items: center; justify-content: space-between;">
            <span style="font-size: 11px; font-weight: 800; color: var(--text-muted);">Hasil Proyeksi Sistem</span>
            <span style="font-size: 10px; font-weight: 700; color: var(--brand-green-dark);">Algoritma Kalender Otomatis</span>
          </div>
          <div style="display: flex; align-items: baseline; justify-content: space-between; border-bottom: 1px dashed var(--brand-green-border); padding-bottom: 6px;">
            <span style="font-size: 11.5px; color: var(--text-main); font-weight: 700;">Target Total Bulan Ini:</span>
            <strong id="calc-monthly-total" style="font-size: 15px; color: var(--text-main); font-weight: 900;">Rp 123.336.000</strong>
          </div>
          
          <div style="display: flex; flex-direction: column; gap: 4px; font-size: 11px;">
            <div style="display: flex; justify-content: space-between; align-items: center;">
              <span style="color: var(--text-muted);">Target Hari Ini (Kamis, Weekday):</span>
              <strong id="calc-today-target" style="color: var(--brand-green-dark); font-size: 13.5px; font-weight: 800;">Rp 5.380.000</strong>
            </div>
            <div style="display: flex; justify-content: space-between; color: var(--text-muted); font-size: 10px;">
              <span>• Weekday (Bobot 0.8x): <strong id="calc-weekday-target">~Rp 3.65jt</strong></span>
              <span>• Weekend (Bobot 1.5x): <strong id="calc-weekend-target">~Rp 6.85jt</strong></span>
            </div>
          </div>
        </div>

        <!-- Incentive Pool Note -->
        <div style="font-size: 11px; color: var(--text-muted); background: var(--bg-surface); padding: 9px 11px; border-radius: var(--radius-sm); border: 1px dashed var(--border-light); line-height: 1.4;">
          🎁 <strong>Skema Insentif Otomatis:</strong> Cabang yang mencapai &gt;100% target otomatis membuka alokasi bonus pool <strong>Rp 2.500.000</strong> untuk Store Manager dan kru toko di akhir bulan.
        </div>
      </div>

      <!-- Action Buttons -->
      <div style="display: flex; gap: 10px;">
        <button type="button" style="flex: 1; padding: 12px 10px; background: var(--brand-green); color: #fff; border: none; border-radius: var(--radius-md); font-family: inherit; font-size: 12px; font-weight: 800; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px;" onclick="saveAndApplyTarget()">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
          <span>Simpan & Terapkan Target</span>
        </button>
        <button type="button" style="padding: 12px 16px; background: var(--bg-subtle); color: var(--text-main); border: 1px solid var(--border-light); border-radius: var(--radius-md); font-family: inherit; font-size: 12.5px; font-weight: 700; cursor: pointer;" onclick="closeAllSheets()">
          Batal
        </button>
      </div>
    </div>

  </div>

  <!-- ==========================================================================
       INTERACTIVE CLIENT CONTROLLER (VANILLA JS)
       ========================================================================== -->
  <script>
    // State
    let isPrivacyMode = false;
    let isDarkTheme = false;
    let isFrameMode = true;
    let isExpandedActions = false;
    let isSentinelWarning = true;

    // Toast Timer
    let toastTimeout = null;
    function showToast(title, msg) {
      const toast = document.getElementById('app-toast');
      document.getElementById('toast-title').textContent = title;
      document.getElementById('toast-msg').textContent = msg;
      
      toast.classList.add('show');
      if (toastTimeout) clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove('show');
      }, 3200);
    }

    // Toggle Privacy Masking on Numbers
    function togglePrivacyMode() {
      isPrivacyMode = !isPrivacyMode;
      const rev = document.getElementById('kpi-revenue-display');
      const cash = document.getElementById('substat-cash');
      const online = document.getElementById('substat-online');
      const eyeSvg = document.getElementById('eye-svg');

      if (isPrivacyMode) {
        rev.textContent = 'Rp ••••••••';
        cash.textContent = 'Rp ••••••';
        online.textContent = 'Rp ••••••';
        eyeSvg.innerHTML = '<path d="m2 2 20 20"/><path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"/><path d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"/><path d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"/>';
        showToast('Mode Privasi Aktif', 'Nominal pendapatan disembunyikan');
      } else {
        const curBranch = document.getElementById('current-branch-label').textContent;
        if (curBranch.includes('Pringsewu')) {
          rev.textContent = 'Rp 2.450.000';
          cash.textContent = 'Rp 750rb';
          online.textContent = 'Rp 1.70jt';
        } else if (curBranch.includes('Gadingrejo')) {
          rev.textContent = 'Rp 1.150.000';
          cash.textContent = 'Rp 320rb';
          online.textContent = 'Rp 830rb';
        } else if (curBranch.includes('Kemiling')) {
          rev.textContent = 'Rp 720.000';
          cash.textContent = 'Rp 180rb';
          online.textContent = 'Rp 540rb';
        } else {
          rev.textContent = 'Rp 4.320.000';
          cash.textContent = 'Rp 1.2jt';
          online.textContent = 'Rp 3.12jt';
        }
        eyeSvg.innerHTML = '<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/>';
        showToast('Mode Privasi Nonaktif', 'Nominal pendapatan ditampilkan');
      }
    }

    // Expand / Collapse Action Grid
    function toggleExpandActions() {
      isExpandedActions = !isExpandedActions;
      const el = document.getElementById('expanded-actions-grid');
      const btnText = document.getElementById('btn-toggle-expand-text');
      
      if (isExpandedActions) {
        el.classList.add('show');
        btnText.textContent = 'Sembunyikan';
      } else {
        el.classList.remove('show');
        btnText.textContent = 'Lihat Semua (8)';
      }
    }

    // Modal Sheet Controllers
    function closeAllSheets() {
      document.getElementById('sheet-overlay').classList.remove('active');
      document.getElementById('branch-sheet').classList.remove('active');
      document.getElementById('anomaly-sheet').classList.remove('active');
      const targetSheet = document.getElementById('target-sheet');
      if (targetSheet) targetSheet.classList.remove('active');
    }

    function openTargetSheet() {
      closeAllSheets();
      document.getElementById('sheet-overlay').classList.add('active');
      const targetSheet = document.getElementById('target-sheet');
      if (targetSheet) targetSheet.classList.add('active');
      recalculateTargetUI();
    }

    function openBranchSheet() {
      closeAllSheets();
      document.getElementById('sheet-overlay').classList.add('active');
      document.getElementById('branch-sheet').classList.add('active');
    }

    function openAnomalySheet() {
      closeAllSheets();
      document.getElementById('sheet-overlay').classList.add('active');
      document.getElementById('anomaly-sheet').classList.add('active');
    }

    function closeAnomalySheet() {
      closeAllSheets();
    }

    // Audit Sheet Tab Controller (Barometer Wewenang)
    function switchAuditTab(tab) {
      const btnPending = document.getElementById('tab-btn-pending');
      const btnFyi = document.getElementById('tab-btn-fyi');
      const contentPending = document.getElementById('audit-content-pending');
      const contentFyi = document.getElementById('audit-content-fyi');

      if (tab === 'pending') {
        if (btnPending) btnPending.classList.add('active');
        if (btnFyi) btnFyi.classList.remove('active');
        if (contentPending) contentPending.style.display = 'block';
        if (contentFyi) contentFyi.style.display = 'none';
      } else {
        if (btnFyi) btnFyi.classList.add('active');
        if (btnPending) btnPending.classList.remove('active');
        if (contentPending) contentPending.style.display = 'none';
        if (contentFyi) contentFyi.style.display = 'block';
      }
    }

    // Model B Governance: Resolve individual anomaly (Otorisasi vs Veto)
    function resolveSingleAnomaly(cardId, action, toastMsg) {
      const card = document.getElementById(cardId);
      const settledPill = document.getElementById(cardId + '-settled');
      if (!card || !settledPill) return;

      card.classList.remove('state-approved', 'state-vetoed');
      card.classList.add(action === 'approved' ? 'state-approved' : 'state-vetoed');

      if (action === 'approved') {
        settledPill.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Disahkan Owner: Otorisasi Beban Diterima</span>';
      } else {
        settledPill.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>Di-Veto Owner: Dialihkan Sesuai Ketentuan Baru</span>';
      }

      showToast(action === 'approved' ? 'Putusan Disahkan' : 'Hak Veto Dijalankan', toastMsg);
      checkAllAnomaliesSettled();
    }

    // Model B Governance: Batch approve all critical cases
    function approveAllBranchDecisions() {
      resolveSingleAnomaly('anomaly-card-1', 'approved', 'Selisih kas laci Rp 175rb disahkan beban operasional resto');
      resolveSingleAnomaly('anomaly-card-2', 'approved', 'Wewenang PIN SPV Rian dibuka kembali');
      showToast('Otorisasi Penuh Selesai', 'Semua kasus berat telah disahkan Owner');
      setTimeout(() => {
        closeAllSheets();
      }, 700);
    }

    // Check if all anomalies are settled and sync banner
    function checkAllAnomaliesSettled() {
      const cards = [document.getElementById('anomaly-card-1'), document.getElementById('anomaly-card-2')];
      const unSettled = cards.filter(c => c && !c.classList.contains('state-approved') && !c.classList.contains('state-vetoed'));
      const badgeTab = document.getElementById('badge-tab-pending');
      const banner = document.getElementById('sentinel-banner');
      const icon = document.getElementById('sentinel-icon');
      const title = document.getElementById('sentinel-title');
      const sub = document.getElementById('sentinel-sub');
      const btn = document.getElementById('btn-toggle-sentinel');
      const badge = document.getElementById('sentinel-btn-text');

      if (unSettled.length === 0) {
        if (badgeTab) {
          badgeTab.textContent = '0';
          badgeTab.classList.remove('badge-danger');
          badgeTab.classList.add('badge-neutral');
        }
        isSentinelWarning = false;
        banner.classList.add('safe-mode');
        icon.textContent = '🛡️';
        title.textContent = 'Integritas Operasional Terkendali';
        sub.textContent = 'Semua kasus berat telah diputuskan • 3 log cabang terdata rapi';
        badge.innerHTML = '<span>Aman</span>';
        if (btn) btn.textContent = '🛡️ Status: Bersih';
      } else {
        if (badgeTab) {
          badgeTab.textContent = unSettled.length;
          badgeTab.classList.remove('badge-neutral');
          badgeTab.classList.add('badge-danger');
        }
        isSentinelWarning = true;
        banner.classList.remove('safe-mode');
        icon.textContent = '⚠️';
        title.textContent = `${unSettled.length} Kasus Kritis Butuh Putusan Owner`;
        sub.textContent = 'Melampaui Limit Cabang • 3 Masalah Ringan Selesai Mandiri';
        badge.innerHTML = '<span>Putuskan</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>';
        if (btn) btn.textContent = '⚠️ Status: Perlu Putusan';
      }
    }

    // Toggle Sentinel Warning Mode vs Safe Mode
    function toggleSentinelState() {
      isSentinelWarning = !isSentinelWarning;
      const banner = document.getElementById('sentinel-banner');
      const icon = document.getElementById('sentinel-icon');
      const title = document.getElementById('sentinel-title');
      const sub = document.getElementById('sentinel-sub');
      const btn = document.getElementById('btn-toggle-sentinel');
      const badge = document.getElementById('sentinel-btn-text');
      const badgeTab = document.getElementById('badge-tab-pending');
      const card1 = document.getElementById('anomaly-card-1');
      const card2 = document.getElementById('anomaly-card-2');

      if (isSentinelWarning) {
        if (card1) card1.classList.remove('state-approved', 'state-vetoed');
        if (card2) card2.classList.remove('state-approved', 'state-vetoed');
        if (badgeTab) {
          badgeTab.textContent = '2';
          badgeTab.classList.remove('badge-neutral');
          badgeTab.classList.add('badge-danger');
        }
        banner.classList.remove('safe-mode');
        icon.textContent = '⚠️';
        title.textContent = '2 Kasus Kritis Butuh Putusan Owner';
        sub.textContent = 'Melampaui Limit Cabang • 3 Masalah Ringan Selesai Mandiri';
        badge.innerHTML = '<span>Putuskan</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>';
        btn.textContent = '⚠️ Status: Perlu Putusan';
        showToast('Mode Audit Aktif', 'Menampilkan 2 kasus berat melampaui limit wewenang cabang');
      } else {
        if (card1) card1.classList.add('state-approved');
        if (card2) card2.classList.add('state-approved');
        const p1 = document.getElementById('anomaly-card-1-settled');
        const p2 = document.getElementById('anomaly-card-2-settled');
        if (p1) p1.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Disahkan Owner: Otorisasi Beban Diterima</span>';
        if (p2) p2.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg><span>Disahkan Owner: Otorisasi Beban Diterima</span>';
        if (badgeTab) {
          badgeTab.textContent = '0';
          badgeTab.classList.remove('badge-danger');
          badgeTab.classList.add('badge-neutral');
        }
        banner.classList.add('safe-mode');
        icon.textContent = '🛡️';
        title.textContent = 'Integritas Operasional Terkendali';
        sub.textContent = 'Semua kasus berat telah diputuskan • 3 log cabang terdata rapi';
        badge.innerHTML = '<span>Aman</span>';
        btn.textContent = '🛡️ Status: Bersih';
        showToast('Mode Bersih', 'Semua kasus berat telah tuntas diputuskan');
      }
    }

    function resolveAnomalies() {
      approveAllBranchDecisions();
    }

    // Branch Switcher Dynamic Engine
    function selectBranch(name, sub) {
      document.getElementById('current-branch-label').textContent = name;
      closeAllSheets();

      // Update active check in modal
      document.querySelectorAll('.branch-select-row').forEach(r => r.classList.remove('selected'));
      if (name.includes('Semua Cabang')) {
        document.getElementById('row-branch-all').classList.add('selected');
      } else if (name.includes('Pringsewu')) {
        document.getElementById('row-branch-pringsewu').classList.add('selected');
      } else if (name.includes('Gadingrejo')) {
        document.getElementById('row-branch-gadingrejo').classList.add('selected');
      } else if (name.includes('Kemiling')) {
        document.getElementById('row-branch-kemiling').classList.add('selected');
      }

      const multiSection = document.getElementById('multi-branch-section');
      const singleSection = document.getElementById('single-branch-section');
      const rev = document.getElementById('kpi-revenue-display');
      const targetFill = document.getElementById('target-fill-bar');

      if (name.includes('Semua Cabang')) {
        multiSection.style.display = 'flex';
        singleSection.classList.remove('show');
        if (!isPrivacyMode) rev.textContent = 'Rp 4.320.000';
        targetFill.style.width = '80.3%';
        showToast('Konsolidasi', 'Menampilkan agregat 3 cabang');
      } else {
        multiSection.style.display = 'none';
        singleSection.classList.add('show');

        if (name.includes('Pringsewu')) {
          document.getElementById('single-branch-title').textContent = 'Monitoring Shift & Kas • Pringsewu';
          document.getElementById('single-cash-drawer').textContent = 'Rp 1.450.000';
          document.getElementById('single-cash-breakdown').textContent = 'Modal Rp 200k + Kas Masuk Rp 1.25M';
          document.getElementById('single-kitchen-speed').textContent = '11.4 mnt';
          document.getElementById('single-cashier-name').textContent = 'Siti Rahma';
          if (!isPrivacyMode) rev.textContent = 'Rp 2.450.000';
          targetFill.style.width = '100%';
        } else if (name.includes('Gadingrejo')) {
          document.getElementById('single-branch-title').textContent = 'Monitoring Shift & Kas • Gadingrejo';
          document.getElementById('single-cash-drawer').textContent = 'Rp 620.000';
          document.getElementById('single-cash-breakdown').textContent = 'Modal Rp 150k + Kas Masuk Rp 470k';
          document.getElementById('single-kitchen-speed').textContent = '9.8 mnt';
          document.getElementById('single-cashier-name').textContent = 'Agus Riyadi';
          if (!isPrivacyMode) rev.textContent = 'Rp 1.150.000';
          targetFill.style.width = '78%';
        } else if (name.includes('Kemiling')) {
          document.getElementById('single-branch-title').textContent = 'Monitoring Shift & Kas • Kemiling';
          document.getElementById('single-cash-drawer').textContent = 'Rp 410.000 (Selisih -Rp 15k)';
          document.getElementById('single-cash-breakdown').textContent = 'Modal Rp 100k + Kas Masuk Rp 310k';
          document.getElementById('single-kitchen-speed').textContent = '14.2 mnt';
          document.getElementById('single-cashier-name').textContent = 'Rina Dewi';
          if (!isPrivacyMode) rev.textContent = 'Rp 720.000';
          targetFill.style.width = '48%';
        }
        showToast(name, 'Menampilkan data operasional ' + name);
      }
    }

    // Period Menu
    function openPeriodMenu() {
      const periods = ['Hari ini', 'Kemarin', '7 Hari Terakhir', 'Bulan Ini'];
      const current = document.getElementById('kpi-period-label').textContent;
      let nextIdx = (periods.indexOf(current) + 1) % periods.length;
      let next = periods[nextIdx];
      
      document.getElementById('kpi-period-label').textContent = next;
      
      if (next === 'Hari ini') {
        document.getElementById('kpi-revenue-display').textContent = 'Rp 4.320.000';
        document.getElementById('kpi-date-text').textContent = '29 Oktober 2026';
        document.getElementById('target-fill-bar').style.width = '80.3%';
      } else if (next === 'Kemarin') {
        document.getElementById('kpi-revenue-display').textContent = 'Rp 3.840.000';
        document.getElementById('kpi-date-text').textContent = '28 Oktober 2026';
        document.getElementById('target-fill-bar').style.width = '64.0%';
      } else if (next === '7 Hari Terakhir') {
        document.getElementById('kpi-revenue-display').textContent = 'Rp 28.950.000';
        document.getElementById('kpi-date-text').textContent = '22 - 28 Okt 2026';
        document.getElementById('target-fill-bar').style.width = '92.5%';
      } else {
        document.getElementById('kpi-revenue-display').textContent = 'Rp 114.200.000';
        document.getElementById('kpi-date-text').textContent = 'Oktober 2026';
        document.getElementById('target-fill-bar').style.width = '95.1%';
      }
      
      showToast('Filter Periode', 'Menampilkan data: ' + next);
    }

    function showChartPointInfo() {
      showToast('Analisa Jam Sibuk', 'Pukul 12:00 adalah jam makan siang dengan pesanan tertinggi');
    }

    // Bottom Navigation Switcher
    function switchNavTab(btn, tabName) {
      document.querySelectorAll('.nav-tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      showToast(tabName, 'Membuka tampilan navigasi ' + tabName);
    }

    // Presentation Bar Toggles
    function toggleDeviceFrame() {
      isFrameMode = !isFrameMode;
      const shell = document.getElementById('device-shell');
      const btn = document.getElementById('btn-toggle-frame');
      
      if (isFrameMode) {
        shell.classList.remove('fullscreen-mode');
        btn.classList.add('active');
      } else {
        shell.classList.add('fullscreen-mode');
        btn.classList.remove('active');
      }
    }

    function toggleTheme() {
      isDarkTheme = !isDarkTheme;
      const btn = document.getElementById('btn-toggle-theme');
      
      if (isDarkTheme) {
        document.documentElement.setAttribute('data-theme', 'dark');
        btn.textContent = '☀️ Light Mode';
        btn.classList.add('active');
      } else {
        document.documentElement.removeAttribute('data-theme');
        btn.textContent = '🌙 Dark Mode';
        btn.classList.remove('active');
      }
    }

    function simulateIncomingOrder() {
      showToast('⚡ Order Masuk!', '#MB-9042 • Rp 92.000 • 2x Ayam Petruk Sambal Matah');
      
      // Bump live counter
      const stEl = document.querySelector('.stage-number');
      if (stEl) {
        let cur = parseInt(stEl.textContent, 10) || 3;
        stEl.textContent = cur + 1;
      }
    }

    
    // Target Management State & Data Store
    let currentTargetScope = 'all'; // 'all', 'pringsewu', 'gadingrejo', 'kemiling'
    let currentTargetMode = 'smart'; // 'smart' or 'nominal'
    let targetGrowthPct = 8;

    const branchTargetData = {
      all: { name: 'Konsolidasi 3 Cabang', past: 114200000, bep: 78000000, todayActual: 4320000, weekdayMult: 0.85, weekendMult: 1.45 },
      pringsewu: { name: 'MyBangjo Pringsewu', past: 68000000, bep: 44000000, todayActual: 2450000, weekdayMult: 0.9, weekendMult: 1.4 },
      gadingrejo: { name: 'MyBangjo Gadingrejo', past: 32000000, bep: 22000000, todayActual: 1150000, weekdayMult: 0.8, weekendMult: 1.5 },
      kemiling: { name: 'MyBangjo Kemiling', past: 14200000, bep: 12000000, todayActual: 720000, weekdayMult: 0.8, weekendMult: 1.5 }
    };

    function setTargetScope(scope) {
      currentTargetScope = scope;
      document.querySelectorAll('.target-scope-btn').forEach(b => b.classList.remove('active'));
      const activeBtn = document.getElementById(`scope-btn-${scope}`);
      if (activeBtn) activeBtn.classList.add('active');

      const data = branchTargetData[scope];
      if (data) {
        document.getElementById('scope-base-past').textContent = formatRupiah(data.past);
        document.getElementById('scope-base-bep').textContent = formatRupiah(data.bep);
        recalculateTargetUI();
      }
    }

    function switchTargetMode(mode) {
      currentTargetMode = mode;
      const btnSmart = document.getElementById('tab-mode-smart');
      const btnNominal = document.getElementById('tab-mode-nominal');
      const conSmart = document.getElementById('container-mode-smart');
      const conNominal = document.getElementById('container-mode-nominal');

      if (mode === 'smart') {
        if (btnSmart) btnSmart.classList.add('active');
        if (btnNominal) btnNominal.classList.remove('active');
        if (conSmart) conSmart.style.display = 'block';
        if (conNominal) conNominal.style.display = 'none';
      } else {
        if (btnNominal) btnNominal.classList.add('active');
        if (btnSmart) btnSmart.classList.remove('active');
        if (conSmart) conSmart.style.display = 'none';
        if (conNominal) conNominal.style.display = 'block';
      }
      recalculateTargetUI();
    }

    function onGrowthSliderChange(val) {
      targetGrowthPct = parseInt(val, 10);
      const badge = document.getElementById('growth-badge-text');
      if (badge) badge.textContent = `+${targetGrowthPct}%`;
      recalculateTargetUI();
    }

    function onNominalInputChange(val) {
      recalculateTargetUI();
    }

    function recalculateTargetUI() {
      const data = branchTargetData[currentTargetScope];
      if (!data) return;
      let monthlyTotal = 0;

      if (currentTargetMode === 'smart') {
        monthlyTotal = Math.round(data.past * (1 + targetGrowthPct / 100));
        const nomInput = document.getElementById('input-nominal-val');
        if (nomInput) nomInput.value = monthlyTotal;
      } else {
        const nomInput = document.getElementById('input-nominal-val');
        monthlyTotal = parseInt(nomInput ? nomInput.value : data.past, 10) || data.past;
      }

      const baseDaily = monthlyTotal / 30;
      const weekdayTarget = Math.round(baseDaily * data.weekdayMult);
      const weekendTarget = Math.round(baseDaily * data.weekendMult);
      const todayTarget = weekdayTarget;

      const monthlyEl = document.getElementById('calc-monthly-total');
      const todayEl = document.getElementById('calc-today-target');
      const weekdayEl = document.getElementById('calc-weekday-target');
      const weekendEl = document.getElementById('calc-weekend-target');

      if (monthlyEl) monthlyEl.textContent = formatRupiah(monthlyTotal);
      if (todayEl) todayEl.textContent = formatRupiah(todayTarget);
      if (weekdayEl) weekdayEl.textContent = '~' + formatRupiah(weekdayTarget);
      if (weekendEl) weekendEl.textContent = '~' + formatRupiah(weekendTarget);
    }

    function saveAndApplyTarget() {
      const data = branchTargetData[currentTargetScope];
      let monthlyTotal = 0;
      if (currentTargetMode === 'smart') {
        monthlyTotal = Math.round(data.past * (1 + targetGrowthPct / 100));
      } else {
        const nomInput = document.getElementById('input-nominal-val');
        monthlyTotal = parseInt(nomInput ? nomInput.value : data.past, 10) || data.past;
      }
      const todayTarget = Math.round((monthlyTotal / 30) * data.weekdayMult);

      if (currentTargetScope === 'all') {
        const actual = data.todayActual;
        const pct = ((actual / todayTarget) * 100).toFixed(1);
        const goalLabel = document.getElementById('target-goal-label');
        const progressLabel = document.getElementById('target-progress-label');
        const fillBar = document.getElementById('target-fill-bar');

        if (goalLabel) goalLabel.innerHTML = `Target: ${formatRupiah(todayTarget)} <span style="font-size: 11px; opacity: 0.85;">⚙️</span>`;
        if (progressLabel) progressLabel.textContent = `Capaian Target: ${pct}%`;
        if (fillBar) fillBar.style.width = `${Math.min(pct, 100)}%`;
      }

      closeAllSheets();
      showToast('Target Diperbarui!', `Target ${data.name} berhasil disesuaikan ke ${formatRupiah(todayTarget)}/hari`);
    }

    function formatRupiah(num) {
      return 'Rp ' + Number(num).toLocaleString('id-ID');
    }

    // Deep linking & Automation testing hooks
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('sheet') === 'anomaly') {
      setTimeout(() => {
        openAnomalySheet();
        switchAuditTab('pending');
      }, 150);
    } else if (urlParams.get('sheet') === 'fyi') {
      setTimeout(() => {
        openAnomalySheet();
        switchAuditTab('fyi');
      }, 150);
    } else if (urlParams.get('sheet') === 'target') {
      setTimeout(() => {
        openTargetSheet();
      }, 150);
    }
    if (urlParams.get('test_resolved') === '1') {
      setTimeout(() => {
        openAnomalySheet();
        resolveSingleAnomaly('anomaly-card-1', 'approved', 'Selisih kas laci Rp 175rb disahkan beban operasional resto');
        resolveSingleAnomaly('anomaly-card-2', 'vetoed', 'Perintah Audit CCTV Pringsewu diterbitkan ke tim pengawas');
      }, 150);
    }
    if (urlParams.get('theme') === 'dark') {
      toggleTheme();
    }
  </script>
</body>
</html>

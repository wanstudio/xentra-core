# ==============================================================================
# Xentra Core WhatsApp AI Runner Configuration
# ==============================================================================

# 1. Whitelist nomor WhatsApp yang memiliki izin operator runner (format 62xxx, pisahkan dengan koma jika multi)
# Contoh: 628xxxxxxxxxx
ALLOWED_WHATSAPP_NUMBERS=



# 2. Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Model AI (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

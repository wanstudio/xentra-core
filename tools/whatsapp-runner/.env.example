# ==============================================================================
# Xentra Core WhatsApp AI Runner Configuration
# ==============================================================================

# 1. Nomor WhatsApp Anda yang berhak memberi perintah (Gunakan format 62xxx tanpa tanda + atau spasi)
# Contoh: 6281234567890 (Bisa lebih dari 1 nomor, pisahkan dengan koma)
OWNER_WHATSAPP_NUMBER=6281234567890

# 2. Google Gemini API Key (Dapatkan gratis di https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Model AI (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

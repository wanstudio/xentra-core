# ==============================================================================
# Xentra Core Telegram Runner Configuration
# ==============================================================================

# 1. Telegram Bot Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Telegram User ID Anda (hanya ID ini yang bisa memberi instruksi ke bot)
# Untuk mengetahui ID Anda, kirim pesan apa saja ke bot @userinfobot di Telegram
TELEGRAM_ALLOWED_USER_ID=your_telegram_numeric_id_here